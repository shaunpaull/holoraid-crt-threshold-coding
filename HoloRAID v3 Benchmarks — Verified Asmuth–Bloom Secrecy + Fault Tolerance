# HOLORAID - STANDARD (NO SECRECY)
# ════════════════════════════════════════════════════════════════════════════════

class HoloRAIDStandard:
    """
    Standard HoloRAID - CRT-based k-of-n threshold encoding.
    
    NO information-theoretic secrecy: t < k shards reveal v mod M_t.
    Used for fault tolerance, not secret sharing.
    """
    
    def __init__(self, primes: List[int], k: int, Q: int = 65535):
        self.primes = sorted(primes)
        self.n = len(primes)
        self.k = k
        self.Q = Q
        
        # Verify pairwise coprimality (all distinct primes, so guaranteed)
        for i in range(len(primes)):
            for j in range(i + 1, len(primes)):
                assert gcd(primes[i], primes[j]) == 1
        
        # Verify admissibility: product of any k primes > Q
        self.min_k_product = min(
            reduce(lambda a, b: a * b, [self.primes[i] for i in subset])
            for subset in combinations(range(self.n), self.k)
        )
        
        if self.min_k_product <= Q:
            raise ValueError(
                f"Admissibility violated: min k-product {self.min_k_product} ≤ Q={Q}. "
                f"Use larger primes or smaller Q."
            )
    
    def encode(self, v: int) -> List[int]:
        """Encode value v into n shards: s_i = v mod p_i."""
        assert 0 <= v <= self.Q, f"Value {v} outside [0, {self.Q}]"
        return [v % p for p in self.primes]
    
    def decode(self, shards: List[int], indices: List[int]) -> int:
        """Decode from any k shards using CRT."""
        assert len(shards) == len(indices) == self.k
        moduli = [self.primes[i] for i in indices]
        return crt_reconstruct(shards, moduli)
    
    def test_reconstruction(self, v: int, n_erasures: int = 0) -> Tuple[int, bool]:
        """Test reconstruction after random erasures."""
        shards = self.encode(v)
        
        # Random erasures
        surviving = list(range(self.n))
        if n_erasures > 0:
            max_erasures = min(n_erasures, self.n - self.k)
            erased = random.sample(surviving, max_erasures)
            surviving = [i for i in surviving if i not in erased]
        
        if len(surviving) < self.k:
            return -1, False
        
        # Decode from first k surviving shards
        decode_indices = surviving[:self.k]
        decode_shards = [shards[i] for i in decode_indices]
        
        reconstructed = self.decode(decode_shards, decode_indices)
        return reconstructed, reconstructed == v


