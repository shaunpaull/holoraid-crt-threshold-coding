# HOLORAID - ASMUTH-BLOOM SECRECY (CORRECT IMPLEMENTATION)
# ════════════════════════════════════════════════════════════════════════════════

class HoloRAIDAsmuthBloom:
    """
    HoloRAID with CORRECT Asmuth-Bloom secret sharing.
    
    THE KEY INSIGHT:
    ────────────────
    Asmuth-Bloom requires a "shadow prime" p₀ such that:
    1. Secret s < p₀ (so s mod p₀ = s)
    2. p₀ < p₁ < p₂ < ... < pₙ (sharing primes are larger)
    3. p₀ · ∏(k-1 smallest p_i) < ∏(k smallest p_i)
    
    For Q=65535, we need p₀ > 65535.
    We use p₀ = 65537 (the Fermat prime 2¹⁶ + 1).
    
    ALGORITHM:
    ──────────
    Encode(s):
        1. Choose random r ∈ [0, (M_k - s)/p₀]
        2. Compute s' = s + r·p₀
        3. Create shards: share_i = s' mod p_i
    
    Decode(k shards):
        1. Use CRT to recover s' (works because s' < M_k)
        2. Return s = s' mod p₀
    
    WHY THIS PROVIDES SECRECY:
    ──────────────────────────
    With t < k shards, attacker can only determine s' mod M_t.
    Since r is random, s' mod M_t reveals nothing about s.
    """
    
    def __init__(self, Q: int = 65535, n: int = 5, k: int = 3):
        self.Q = Q
        self.n = n
        self.k = k
        
        # Shadow prime p₀ > Q
        # 65537 = 2^16 + 1 is a Fermat prime, perfect for Q=65535
        self.p0 = next_prime(Q + 1)
        
        # Sharing primes p₁, p₂, ..., pₙ all > p₀
        self.primes = []
        candidate = self.p0 + 1
        while len(self.primes) < n:
            p = next_prime(candidate)
            self.primes.append(p)
            candidate = p + 1
        
        # Compute M_k = product of k smallest sharing primes
        sorted_primes = sorted(self.primes)
        self.M_k = reduce(lambda a, b: a * b, sorted_primes[:k])
        self.M_k_minus_1 = reduce(lambda a, b: a * b, sorted_primes[:k-1]) if k > 1 else 1
        
        # Verify Asmuth-Bloom condition: p₀ · M_{k-1} < M_k
        if self.p0 * self.M_k_minus_1 >= self.M_k:
            raise ValueError(
                f"Asmuth-Bloom condition failed: p₀·M_{{k-1}} = {self.p0 * self.M_k_minus_1} "
                f"≥ M_k = {self.M_k}"
            )
        
        # Compute maximum randomness
        self.max_r = (self.M_k - Q - 1) // self.p0
    
    def encode(self, s: int) -> Tuple[List[int], int]:
        """
        Encode secret s into n shares using Asmuth-Bloom.
        Returns (shares, r) where r is the randomness used.
        """
        assert 0 <= s <= self.Q, f"Secret {s} outside [0, {self.Q}]"
        
        # Choose random r
        r = random.randint(0, self.max_r)
        
        # Compute s' = s + r·p₀
        s_prime = s + r * self.p0
        
        # Sanity check
        assert s_prime < self.M_k, f"s'={s_prime} >= M_k={self.M_k}"
        
        # Create shares
        shares = [s_prime % p for p in self.primes]
        return shares, r
    
    def decode(self, shares: List[int], indices: List[int]) -> int:
        """Decode secret from k shares."""
        assert len(shares) == len(indices) == self.k
        
        # CRT reconstruction to get s'
        moduli = [self.primes[i] for i in indices]
        s_prime = crt_reconstruct(shares, moduli)
        
        # Recover secret: s = s' mod p₀
        s = s_prime % self.p0
        return s
    
    def test_reconstruction(self, s: int, n_erasures: int = 0) -> Tuple[int, bool]:
        """Test reconstruction after random erasures."""
        shares, r = self.encode(s)
        
        # Random erasures
        surviving = list(range(self.n))
        if n_erasures > 0:
            max_erasures = min(n_erasures, self.n - self.k)
            erased = random.sample(surviving, max_erasures)
            surviving = [i for i in surviving if i not in erased]
        
        if len(surviving) < self.k:
            return -1, False
        
        # Decode from first k surviving shares
        decode_indices = surviving[:self.k]
        decode_shares = [shares[i] for i in decode_indices]
        
        reconstructed = self.decode(decode_shares, decode_indices)
        return reconstructed, reconstructed == s
    
    def info(self) -> str:
        """Return configuration info."""
        return (
            f"Asmuth-Bloom HoloRAID Configuration:\n"
            f"  Q (max secret): {self.Q}\n"
            f"  Shadow prime p₀: {self.p0}\n"
            f"  Sharing primes: {self.primes}\n"
            f"  n (total shards): {self.n}\n"
            f"  k (threshold): {self.k}\n"
            f"  M_k: {self.M_k}\n"
            f"  M_{{k-1}}: {self.M_k_minus_1}\n"
            f"  p₀ · M_{{k-1}}: {self.p0 * self.M_k_minus_1}\n"
            f"  max_r: {self.max_r}\n"
            f"  Asmuth-Bloom condition: {self.p0 * self.M_k_minus_1} < {self.M_k} ✓"
        )


