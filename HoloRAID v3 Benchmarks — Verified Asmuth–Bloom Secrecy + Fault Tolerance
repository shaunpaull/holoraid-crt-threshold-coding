# HOLOMIX - DIFFERENTIABLE RELAXATION
# ════════════════════════════════════════════════════════════════════════════════

class HoloMix:
    """
    HoloMix: Multi-frequency interference layer.
    
    HoloMix(x) = x + α · Σᵢ Aᵢ · sin(2πx/pᵢ + φᵢ)
    
    Properties:
    - Theorem 7.1: Gradients exist and are bounded
    - Theorem 7.2: Locally invertible for small α
    - Remark 7.3: Different frequencies are orthogonal
    """
    
    def __init__(self, primes: List[int], alpha: float = 0.25):
        self.primes = primes
        self.alpha = alpha
        
        # Random amplitudes and phases (would be learned in neural net)
        self.amplitudes = np.random.randn(len(primes)) * 0.1
        self.phases = np.random.rand(len(primes)) * 2 * np.pi
    
    def forward(self, x: np.ndarray) -> np.ndarray:
        """Apply HoloMix transformation."""
        interference = np.zeros_like(x)
        for i, p in enumerate(self.primes):
            phase = 2 * np.pi * x / p + self.phases[i]
            interference += self.amplitudes[i] * np.sin(phase)
        return x + self.alpha * interference
    
    def jacobian(self, x: float) -> float:
        """Compute Jacobian at a point."""
        jac = 1.0
        for i, p in enumerate(self.primes):
            phase = 2 * np.pi * x / p + self.phases[i]
            jac += self.alpha * self.amplitudes[i] * (2 * np.pi / p) * np.cos(phase)
        return jac


