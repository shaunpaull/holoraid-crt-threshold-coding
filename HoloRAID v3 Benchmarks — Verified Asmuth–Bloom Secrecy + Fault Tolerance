# SAFEGEAR - BIJECTIVE WINDING PERMUTATION
# ════════════════════════════════════════════════════════════════════════════════

class SafeGear:
    """
    SafeGear: Bijective winding permutation on Z_{ab}.
    
    For coprime (a, b), defines:
    - Forward: W_{a,b}(x) = (r·a + q) mod (ab) where x = qb + r
    - Inverse: W_{a,b}^{-1}(y) = ((y mod a)·b + y//a) mod (ab)
    
    Theorem 8.1: W_{a,b} is a bijection with the stated inverse.
    """
    
    def __init__(self, a: int, b: int):
        assert gcd(a, b) == 1, f"gcd({a}, {b}) must be 1"
        self.a = a
        self.b = b
        self.ab = a * b
    
    def forward(self, x: int) -> int:
        """W_{a,b}(x) = (r·a + q) mod (ab) where x = qb + r."""
        q = x // self.b
        r = x % self.b
        return (r * self.a + q) % self.ab
    
    def inverse(self, y: int) -> int:
        """W_{a,b}^{-1}(y) = ((y mod a)·b + y//a) mod (ab)."""
        return ((y % self.a) * self.b + y // self.a) % self.ab
    
    def verify_bijection(self) -> bool:
        """Verify bijection by checking all values."""
        outputs = set()
        for x in range(self.ab):
            y = self.forward(x)
            x_back = self.inverse(y)
            if x != x_back:
                return False
            outputs.add(y)
        return len(outputs) == self.ab


